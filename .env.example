# Legal AI — runtime configuration.
# Copy to `.env` (gitignored) and fill in. Real environment variables take
# precedence over this file.

# Which LLM backend the citation-forced generator uses: claude | openai
LLM_PROVIDER=claude

# API key for that provider (Anthropic key for claude, OpenAI key for openai).
# Required for POST /query; ingest/retrieve/search work without it.
LLM_API_KEY=

# Optional model override. Defaults: claude -> claude-sonnet-4-6, openai -> gpt-4o
# LLM_MODEL=claude-sonnet-4-6
