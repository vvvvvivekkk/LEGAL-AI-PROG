# Legal AI — runtime configuration.
# Copy to `.env` (gitignored) and fill in. Real environment variables take
# precedence over this file.

# Which LLM backend the citation-forced generator uses: claude | openai | gemini | groq
LLM_PROVIDER=claude

# Anthropic (Claude API) key, used when LLM_PROVIDER=claude. LLM_API_KEY is
# used if this is unset.
ANTHROPIC_API_KEY=

# API key for openai (and for claude if ANTHROPIC_API_KEY is unset).
# A key is required for POST /query; ingest/retrieve/search work without one.
LLM_API_KEY=

# Google AI Studio key, used when LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Groq key, used when LLM_PROVIDER=groq. Groq serves open models behind an
# OpenAI-compatible endpoint. LLM_API_KEY is used if this is unset.
GROQ_API_KEY=

# Optional model override. Defaults: claude -> claude-haiku-5-5, openai -> gpt-4o,
# gemini -> gemini-2.5-flash, groq -> openai/gpt-oss-120b
# Groq's catalogue is per-account: llama-3.3-70b-versatile is not on every key.
# LLM_MODEL=claude-haiku-5-5
