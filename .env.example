# Legal AI — runtime configuration.
# Copy to `.env` (gitignored) and fill in. Real environment variables take
# precedence over this file.

# Which LLM backend the citation-forced generator uses: claude | openai | gemini | groq
LLM_PROVIDER=claude

# API key for claude / openai (Anthropic key or OpenAI key).
# A key is required for POST /query; ingest/retrieve/search work without one.
LLM_API_KEY=

# Google AI Studio key, used when LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Groq key, used when LLM_PROVIDER=groq. Groq serves open models (Llama) behind
# an OpenAI-compatible endpoint.
GROQ_API_KEY=

# Optional model override. Defaults: claude -> claude-sonnet-4-6, openai -> gpt-4o,
# gemini -> gemini-2.5-flash, groq -> llama-3.3-70b-versatile
# LLM_MODEL=claude-sonnet-4-6
